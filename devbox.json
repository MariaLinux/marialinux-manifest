{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": ["git-repo@latest"],
  "shell": {
    "init_hook": ["echo 'Welcome to devbox!' > /dev/null"],
    "scripts": {
      "init-repo": [
        "mkdir -p workspace",
        "cd workspace",
        "repo init -u git@github.com:MariaLinux/marialinux-manifest.git",
        "repo sync -j4"
      ],
      "repo-sync": ["cd workspace", "repo sync -j1"],
      "init-docker": ["docker buildx build -t maria-builder:latest workspace"],
      "build": [
        "docker run --rm -v $(pwd)/workspace:/workspace -w /workspace maria-builder:latest bash -c 'source layers/poky/oe-init-build-env build && bitbake maria-image'"
      ],
      "container": [
        "docker run --rm -it -v $(pwd)/workspace:/workspace -w /workspace maria-builder:latest /bin/bash"
      ]
    }
  }
}
